# Salin ke .env. Jangan commit API key asli.
GOOGLE_API_KEY=
RAG_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_DATA_DIR=data/v2
# Kosong = hanya akses lokal. Untuk multi-pengguna gunakan key berbeda per pemilik.
# Buat key: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEYS={}
# Contoh: RAG_API_KEYS={"mushab":"GANTI_DENGAN_KEY_ACAK_MINIMAL_24_KARAKTER"}
RAG_API_URL=http://127.0.0.1:8000/api/v1
RAG_CLIENT_API_KEY=
RAG_MAX_UPLOAD_MB=20
RAG_MAX_PAGES=100
RAG_MAX_DOCUMENTS_PER_OWNER=50
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
# Jarak cosine lebih kecil = lebih dekat; ini bukan probabilitas kebenaran.
RAG_MAX_COSINE_DISTANCE=0.65
RAG_NATIVE_MIN_CHARS=40
RAG_OCR_DPI=150
RAG_REQUEST_TIMEOUT=60
RAG_UI_TIMEOUT=300
RAG_REQUESTS_PER_MINUTE=30
# Hanya diperlukan jika menjalankan evaluasi dengan --wandb.
WANDB_API_KEY=
